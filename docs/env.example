# ── Prayer Times TV — sample build settings ────────────────────────────────
#
# Copy this file to .env.local in the project folder (Git ignores it) and
# change what you need, then restart `npm run dev` or run `npm run build`:
#   PowerShell:  Copy-Item docs/env.example .env.local
#   bash:        cp docs/env.example .env.local
#
# Everything here is built into the JavaScript the browser downloads, so
# anyone can read it: never put a password or key you use anywhere else.
#
# On GitHub Pages these come from the repository's settings instead of a
# file: Settings → Secrets and variables → Actions (see the README and
# .github/workflows/deploy.yml for the names).

# PIN asked for before Settings opens. Leave empty for no PIN. It keeps
# casual visitors out; it isn't a real lock (see "About the PIN" in the
# README). GitHub: the variable VITE_SETTINGS_PIN (it isn't a secret).
VITE_SETTINGS_PIN=

# Footer test buttons (Test Jumu'ah, Test Pattern, Test Blackout, …).
# true / false. Default: on in development, off in a production build.
# Set it back to false (or delete the line) before building a copy for a
# real masjid screen. GitHub: the variable VITE_SHOW_TEST_BUTTONS (the
# GitHub build leaves them off unless it is true).
VITE_SHOW_TEST_BUTTONS=

# "staging" treats a production build as staging (test buttons on).
VITE_APP_ENV=

# ── Shared masjid settings (docs/remote-settings.md) ─────────────────────────
# none        each screen keeps its own settings (default)
# sheet       Google Sheets: self-serve masjids in your registration sheet,
#             and masjids you list with their own sheet in public/masjids.json
# cloudflare  the Worker in worker/, at VITE_SETTINGS_API_URL
# GitHub: the variable SETTINGS_SOURCE.
VITE_SETTINGS_SOURCE=none

# Cloudflare only: the Worker's address, e.g. https://settings.your-domain.org
# GitHub: the variable SETTINGS_API_URL.
VITE_SETTINGS_API_URL=

# Google Sheet only, for self-serve masjids (both needed; section A1 of the
# guide). Both are public by design: the sheet is view-only, and screens
# apply only rows signed with the key you approved.
#
# The registration form's pre-filled link, made with the answers NAME,
# CITY, CODE, SETTINGS and KEY. Turns on Settings → Share & follow → Register your
# masjid. GitHub: the variable REGISTER_FORM_URL.
VITE_REGISTER_FORM_URL=
# The ID of the form's responses sheet (between /d/ and /edit in its
# address), where every self-serve masjid's signed settings are kept.
# GitHub: the variable REGISTRATIONS_SHEET_ID.
VITE_REGISTRATIONS_SHEET_ID=

# ── Not read from this file ─────────────────────────────────────────────────
# VITE_BASE_URL (the sub-folder the site is served from, e.g.
# /prayer-times-tv/) is read by vite.config.js before env files load, so
# set it in the shell instead:
#   PowerShell:  $env:VITE_BASE_URL='/prayer-times-tv/'; npm run build
#   bash:        VITE_BASE_URL=/prayer-times-tv/ npm run build
# The GitHub workflow sets it to the repository's name automatically.
#
# The Cloudflare Worker's own settings (ALLOWED_ORIGINS, ACCESS_TEAM_DOMAIN,
# ACCESS_AUD, MASJID_ADMINS) live in worker/wrangler.toml or the Cloudflare
# dashboard, not here.
